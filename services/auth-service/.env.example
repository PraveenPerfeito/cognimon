AUTH_SERVICE_ENVIRONMENT=local
AUTH_SERVICE_DATABASE_URL=postgresql+asyncpg://brainmon:brainmon@localhost:5432/brainmon_auth
AUTH_SERVICE_JWT_SECRET=change-me-before-production-32-chars
AUTH_SERVICE_JWT_HEADER_NAME=Authorization
AUTH_SERVICE_JWT_SCHEME=Bearer
AUTH_SERVICE_REFRESH_TOKEN_SECRET=
AUTH_SERVICE_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_SERVICE_METRICS_ENABLED=true
AUTH_SERVICE_AUDIT_LOG_ENABLED=true
AUTH_SERVICE_EVENT_PUBLISHER_BACKEND=log
AUTH_SERVICE_PASSWORD_PEPPER=
AUTH_SERVICE_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_SERVICE_ALLOWED_ORIGINS=["http://localhost:3000"]
AUTH_SERVICE_LOG_LEVEL=INFO
